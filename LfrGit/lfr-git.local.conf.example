# LfrGit per-user config. Copy to lfr-git.local.conf and set your team's fork.
# lfr-git.local.conf is gitignored, so your team setting stays local.

# Your team's fork org on GitHub. lfrGitSync / lfrGitSyncEE sync upstream into it.
LFR_GIT_FORK_ORG="your-team-fork-org"

# Upstream org to sync from (default: liferay).
LFR_GIT_UPSTREAM_ORG="liferay"

# The remote lfrGitUpdateBranch and lfrGitCheckoutTag take release branches and
# patch tags from (default: upstream).
LFR_GIT_UPSTREAM_REMOTE="upstream"

# Master mirror branches for lfrGitUpdateMaster to keep current, as
# "branch:remote" pairs. Each is updated from <remote>/master and created (local
# + on your fork) if it does not exist. Defaults to ("master:upstream").
LFR_GIT_MASTER_MIRRORS=("master:upstream" "masterBrian:brian")

# The master mirror branches of a liferay-portal-ee checkout. Defaults to
# ("master:upstream").
LFR_GIT_MASTER_MIRRORS_EE=("master:upstream")

# The other repos that lfrGitUpdateMaster also updates, from any repo where you
# run it. Each repo uses its own mirrors and syncs its own fork.
LFR_GIT_UPDATE_REPOS=("${HOME}/liferay/repos/liferay-portal" "${HOME}/liferay/repos/liferay-portal-ee")

# Branches lfrGitUpdateMaster -a leaves alone, as glob patterns. Defaults to
# ("KEEP-*").
LFR_GIT_REBASE_ALL_EXCLUDE=("KEEP-*")

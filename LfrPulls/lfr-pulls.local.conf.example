# LfrPulls per-user config. Copy to lfr-pulls.local.conf and set your values.
# lfr-pulls.local.conf is gitignored, so your settings stay local.

# The repo whose open pull requests to list (owner/name). Defaults to the Brian
# CI mirror.
LFR_PULLS_REPO="brianchandotcom/liferay-portal"

# Your fork owner, marking which forwarded PRs are "yours". It is matched against
# the sender-<owner> in the forwarded head branch. Defaults to LFR_GIT_FORK_ORG
# if that is set. Use your team fork org, or your GitHub login if you forward
# from a personal fork.
# Leave it unset unless you forward from an org fork: it defaults to your own
# login, which is what a pull you forwarded carries.
#LFR_PULLS_MINE_ORG="your-github-login"

# Your GitHub login, marking which directly-opened PRs are "yours". Defaults to
# the gh-authenticated user. A PR counts as yours if it is forwarded from
# LFR_PULLS_MINE_ORG or authored by LFR_PULLS_USER.
LFR_PULLS_USER="your-github-login"

# Your team's GitHub account, whose fork bare lfrPulls shows as its second
# section. Defaults to LFR_GIT_FORK_ORG from LfrGit, which already holds it.
# Run `lfrPulls teams` for the list.
#LFR_PULLS_TEAM="liferay-page-management"

# Your team members' GitHub logins. Bare lfrPulls checks each one's fork for
# your pulls and the reviews asked of you. A team account is a GitHub user, not
# an organisation, so the list cannot be read off GitHub.
#LFR_PULLS_TEAM_MEMBERS="login1 login2"

# The AI tooling forks, checked the same way. Defaults to Kenji Heigel and
# Alejandro Tardin, who review the .claude skills and rules.
#LFR_PULLS_AI_FORKS="kenjiheigel 4lejandrito"

# The fork repo name used for a team or user section (<owner>/<name>). Defaults
# to the name part of LFR_PULLS_REPO, i.e. liferay-portal.
#LFR_PULLS_FORK_REPO="liferay-portal"

# Clickable #number links: on, off, or auto (the default, meaning a terminal
# only). The URL rides in an OSC 8 escape, so the table keeps its widths.
#LFR_PULLS_LINKS="auto"

# Local clone whose history is grepped for merged titles (stats mine, week, and
# ticket's landing footer). Defaults to the repo you run the command from.
#LFR_PULLS_MASTER_REPO="${HOME}/liferay/repos/liferay-portal"

# The master ref grepped in that clone. Keep it fetched (lfrGitUpdateMaster).
#LFR_PULLS_MASTER_REF="brian/master"

# How far back lfrPulls rejected looks, and the rejected section of bare
# lfrPulls with it. Every closed pull in the window is read with its comments, so a long
# window is slow.
#LFR_PULLS_REJECTED_DAYS="30"
